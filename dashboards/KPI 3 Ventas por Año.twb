          <metadata-record class='measure'>
            <remote-name>[Measures].[ProfitMargin]</remote-name>
            <remote-type>5</remote-type>
            <local-name>[ProfitMargin]</local-name>
            <remote-alias>[Measures].[ProfitMargin]</remote-alias>
            <caption>ProfitMargin</caption>
            <local-type>real</local-type>
            <aggregation>Avg</aggregation>
            <contains-null>true</contains-null>
            <attributes>
              <attribute datatype='string' name='EXPRESSION'>&quot;IIF(
    [Measures].[Sales Amount] = 0,
    NULL,
    ([Measures].[Sales Amount] - [Measures].[Total Product Cost])
    / [Measures].[Sales Amount]
)&quot;</attribute>
              <attribute datatype='string' name='FORMAT_STRING'>&quot;Percent&quot;</attribute>
              <attribute datatype='string' name='MEASURE_DISPLAY_FOLDER'>&quot;&quot;</attribute>
              <attribute datatype='string' name='SQL_COLUMN_NAME'>&quot;[].[ProfitMargin]&quot;</attribute>
            </attributes>
          </metadata-record>
          <metadata-record class='measure'>
            <remote-name>[Measures].[SalesAmountYTD]</remote-name>
            <remote-type>5</remote-type>
            <local-name>[SalesAmountYTD]</local-name>
            <remote-alias>[Measures].[SalesAmountYTD]</remote-alias>
            <caption>SalesAmountYTD</caption>
            <local-type>real</local-type>
            <aggregation>Avg</aggregation>
            <contains-null>true</contains-null>
            <attributes>
              <attribute datatype='string' name='EXPRESSION'>&quot;SUM(
    YTD([Date].[Calendar].CurrentMember),
    [Measures].[Sales Amount]
